#!/usr/bin/env bash
# ==============================================================================
# TallyPitch Pre-Commit Hook
# Enable locally: git config core.hooksPath .githooks
# ==============================================================================

set -euo pipefail

echo "==> Running TallyPitch pre-commit verification..."

# 1. Run pipeline doctor
if [ -x "./pipeline.sh" ]; then
    ./pipeline.sh doctor
fi

# 2. Check distribution parity
if [ -f "index.html" ] && [ -f "dist/index.html" ]; then
    if ! cmp -s index.html dist/index.html; then
        echo "✗ Error: dist/index.html is out of sync with index.html!"
        echo "  Run './pipeline.sh heal' or './pipeline.sh package' before committing."
        exit 1
    fi
fi

# 3. Run fast smoke tests if python/pytest available
if command -v python3 >/dev/null 2>&1 && [ -x "./pipeline.sh" ]; then
    ./pipeline.sh test --smoke || {
        echo "✗ Pre-commit smoke tests failed. Commit aborted."
        exit 1
    }
fi

echo "✓ Pre-commit checks passed cleanly."
