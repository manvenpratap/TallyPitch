# Environment Variable Template for CricHeroes Replica
# Duplicate this file to .env.local and populate with your credentials.

# -----------------------------------------------------------------------------
# 1. Supabase Database & Auth (Project Settings -> API)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# -----------------------------------------------------------------------------
# 2. Stripe Payments & Subscriptions (Stripe Dashboard -> Developers -> API Keys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# -----------------------------------------------------------------------------
# 3. Transactional Email (Resend -> API Keys)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="CricHeroes <notifications@yourdomain.com>"

# -----------------------------------------------------------------------------
# 4. App & WebSocket Configuration
# -----------------------------------------------------------------------------
PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws/live"
