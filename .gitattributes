# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file types
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Explicit binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# GitHub Linguist Overrides
dist/** linguist-generated=true
scripts/seed.sql linguist-vendored=true
